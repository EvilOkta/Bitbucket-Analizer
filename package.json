{
  "name": "bitbucket-repo-analyzer",
  "version": "1.0.0",
  "description": "Enterprise Repository & Architecture Analyzer for Bitbucket Server",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "package:win": "npm run build && electron-builder --win portable",
    "test": "node --test tests/**/*.test.js",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.bitbucket.analyzer",
    "productName": "Bitbucket Architecture Analyzer",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ],
      "signAndEditExecutable": false
    }
  }
}
